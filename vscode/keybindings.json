// Place your key bindings in this file to override the defaults
[
    {
        "key": "escape",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "terminalFocus || sideBarFocus || panelFocus || auxiliaryBarFocus"
    },
    {
        "key": "space",
        "command": "whichkey.show",
        "when": "!editorTextFocus && !terminalFocus && !sideBarFocus && !panelFocus"
    }
]